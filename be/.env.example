DATABASE_URL="postgresql://user:password@localhost:5432/gatepass?schema=public"
PORT=3000

# Generate one, do not copy this line as-is -- the server refuses to start on
# a known placeholder value:  openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN="30d"
SHOW_OTP_IN_RESPONSE="false"

# GatePass's service fee: the share of each booking's parking amount it keeps;
# the host is paid the rest, and the driver pays the listed price with nothing
# on top. Required: the server refuses to start without it.
COMMISSION_RATE="0.10"

# GST on GatePass's service fee (its own supply; the parking is the host's).
# Both required. Nothing charges it yet -- keep off until GatePass has a GSTIN.
GST_ENABLED="false"
GST_RATE="0.18"

# Place search for the Nearby tab's "enter an area manually" field.
# "none" (the default) makes GET /geocode answer 503 and nothing else breaks.
# Proxied through the API on purpose: an EXPO_PUBLIC_ key ships in the bundle.
GEOCODE_PROVIDER="none"
OLA_MAPS_API_KEY=""
GOOGLE_MAPS_API_KEY=""

# Payment gateway. "none" (the default) books with no order behind it; the
# booking response carries checkout: null. "cashfree" opens a Cashfree order
# for every spot booking. Keys: Cashfree dashboard > Developers > API keys.
# CASHFREE_ENV=sandbox is refused when NODE_ENV=production.
PAYMENT_PROVIDER="none"
CASHFREE_ENV="sandbox"
CASHFREE_CLIENT_ID=""
CASHFREE_CLIENT_SECRET=""
CASHFREE_API_VERSION="2026-01-01"
# Where the payment page sends the driver back (via /payments/return). On a
# real phone use the LAN address of this API, e.g. http://192.168.1.20:3000.
API_PUBLIC_URL="http://127.0.0.1:3000"
APP_WEB_URL="http://localhost:8081"
# Public HTTPS address Cashfree posts payment webhooks to (+ /webhooks/cashfree),
# sent with every order as notify_url. Production: the API's own domain.
# Development: run `npm run tunnel` and paste the https://....trycloudflare.com
# URL it prints, then recreate the API (docker compose up -d be). A quick
# tunnel's URL changes every time it starts. Empty = no webhooks; bookings
# are still confirmed when the pay screen checks.
WEBHOOK_PUBLIC_URL=""

INTEGRATION_TIMEOUT_MS="10000"
INTEGRATION_MAX_RETRIES="2"

EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="no-reply@gatepass.app"
EMAIL_FROM_NAME="GatePass"

# Push notifications. "console" logs what would be sent; "fcm" sends through
# Firebase Cloud Messaging. For fcm, put the service-account key from Firebase
# console > Project settings > Service accounts at the path below (relative to
# be/; be/secrets/ is gitignored and mounted read-only into the container).
PUSH_PROVIDER="console"
FIREBASE_SERVICE_ACCOUNT_FILE="secrets/firebase-service-account.json"
# The every-minute job that writes due reminders and sends pushes.
NOTIFICATION_JOBS_ENABLED="true"

# Comma-separated Google OAuth client IDs (web,ios,android).
# These are the only accepted ID-token audiences. Leave empty to disable
# Google sign-in; /auth/google then returns 503.
GOOGLE_CLIENT_IDS=""

# Where spot photos and ownership documents are stored.
# "local" stores them on the API's own disk and serves them back, so the real
# presign -> PUT -> read path works before a bucket exists. Dev only: the files
# live in the container and go with it. "s3" is refused at boot until that
# provider is written; see src/integrations/storage.
STORAGE_PROVIDER="local"
# The phone uploads photos to, and loads them from, this URL directly -- so
# for a real device it must be reachable from the phone (same host as
# EXPO_PUBLIC_API_URL, e.g. http://192.168.1.20:3000/uploads), not localhost.
# On this machine use 127.0.0.1, not localhost: on Windows localhost resolves
# to ::1 first, where WSL's relay can hold the port and never answer, so
# uploads hang at the preflight.
STORAGE_PUBLIC_BASE_URL="http://127.0.0.1:3000/uploads"
STORAGE_LOCAL_DIR="uploads"
MAX_UPLOAD_BYTES="8388608"

# Structured JSON logs. Security events are "warn", state changes "info".
LOG_LEVEL="info"
# Only behind a reverse proxy that sets X-Forwarded-For; otherwise a client
# could choose the IP it is rate limited as.
TRUST_PROXY="false"
# Requests per minute per caller (signed-in user, else IP). In-memory store:
# right for one API process, several need a shared one.
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_READ_PER_MIN="300"
RATE_LIMIT_WRITE_PER_MIN="60"
RATE_LIMIT_AUTH_PER_MIN="10"
