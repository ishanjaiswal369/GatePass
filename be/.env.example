DATABASE_URL="postgresql://user:password@localhost:5432/gatepass?schema=public"
PORT=3000

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"
SHOW_OTP_IN_RESPONSE="false"

LOG_LEVEL="info"
LOG_PRETTY="false"
LOG_TO_FILE="true"
LOG_DIR="logs"

SMS_PROVIDER="console"
INTEGRATION_TIMEOUT_MS="10000"
INTEGRATION_MAX_RETRIES="2"

MSG91_AUTH_KEY=""
MSG91_SENDER_ID="GATEPS"
MSG91_TEMPLATE_ID=""

EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="no-reply@gatepass.app"
EMAIL_FROM_NAME="GatePass"
