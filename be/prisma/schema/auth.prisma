model EmailVerification {
  id         String     @id @default(uuid())
  email      String
  code       String
  deviceId   String?
  deviceType String?
  // What this code is allowed to do. Without it a password-reset code would
  // also sign you in, and a login code would let anyone who intercepted it set
  // a password -- the two flows must never share a row.
  purpose    String     @default("LOGIN")
  // Pending signup details, carried until the code is verified so that an
  // unverified email never creates a User row. Null when the code was
  // requested from the sign-in screen.
  firstName  String?
  lastName   String?
  expiresAt  DateTime
  verified   Boolean    @default(false)
  // Wrong-code tries against this row. Once it hits the cap the row stops
  // being eligible, so a 6-digit code cannot be brute-forced.
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([email])
  // Rate limiting counts recent rows per email, per purpose.
  @@index([email, purpose, createdAt])
}

model UserSession {
  id           String     @id @default(uuid())
  userId       String
  deviceId     String
  deviceType   String     @default("OTHER")
  deviceName   String?
  fcmToken     String?
  lastActiveAt DateTime   @default(now())
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@unique([userId, deviceId])
}
