model EmailVerification {
  id         String     @id @default(uuid())
  email      String
  code       String
  deviceId   String?
  deviceType String?
  // Pending signup details, carried until the code is verified so that an
  // unverified email never creates a User row. Null when the code was
  // requested from the sign-in screen.
  firstName  String?
  lastName   String?
  expiresAt  DateTime
  verified   Boolean    @default(false)
  createdAt  DateTime   @default(now())

  @@index([email])
}

model UserSession {
  id           String     @id @default(uuid())
  userId       String
  deviceId     String
  deviceType   String     @default("OTHER")
  deviceName   String?
  fcmToken     String?
  lastActiveAt DateTime   @default(now())
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@unique([userId, deviceId])
}
