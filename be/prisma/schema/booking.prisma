/// A driver's claim on a stretch of time on one host's space (migration
/// 0018_create_booking). The Booking_one_target CHECK requires the listing
/// and both ends of the stay; the Booking_no_overlap EXCLUDE is what stops two
/// drivers booking overlapping hours on the same space -- a counter cannot
/// express that, because the thing competed for is a range, not a quantity.
model Booking {
  id              String        @id @default(uuid())
  /// Required, with both ends (Booking_one_target CHECK); nullable in the
  /// client types only because the columns predate that rule.
  listingId       String?
  startsAt        DateTime?
  endsAt          DateTime?
  /// When an unpaid PENDING hold stops reserving the time. Swept on the next
  /// booking attempt for the same spot, so no scheduler is needed.
  holdExpiresAt   DateTime?
  /// Set on an extension: extra time on the same spot, sold as a booking of
  /// its own so the overlap guard holds it while it is paid for. Updating the
  /// parent's `endsAt` instead would hand the time out before payment.
  extendsBookingId String?
  driverId        String
  vehicleNumber   String
  /// Which of the spot's rates (SpotPricing) the booking was priced at.
  vehicleType     String?
  quantity        Int
  /// The parking itself -- the host's supply, what their share comes from.
  amount          Decimal
  /// A driver-side fee and its GST, fixed when the booking is made. Zero for
  /// new bookings: GatePass charges a service fee from the host's side
  /// instead (config/pricing.ts). Kept so older rows still add up.
  platformFee     Decimal       @default(0)
  taxAmount       Decimal       @default(0)
  status          String        @default("PENDING")
  /// When the driver cancelled, and why if they said. The refund tracker
  /// counts from here; `updatedAt` moves on every later change.
  cancelledAt     DateTime?
  cancellationReason String?
  idempotencyKey  String        @unique
  qrToken         String        @unique
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  listing         Listing?        @relation(fields: [listingId], references: [id], onDelete: Restrict)
  driver          User            @relation(fields: [driverId], references: [id])
  payment         Payment?
  refund          Refund?
  review          Review?
  problem         ProblemReport?
  extendsBooking  Booking?        @relation("BookingExtensions", fields: [extendsBookingId], references: [id], onDelete: Restrict)
  extensions      Booking[]       @relation("BookingExtensions")
  creator         User?           @relation("BookingCreatedBy", fields: [createdBy], references: [id])
  updater         User?           @relation("BookingUpdatedBy", fields: [updatedBy], references: [id])

  @@index([listingId, startsAt])
  // Created by migration SQL before `db push` was the workflow; declared so a
  // push does not drop them.
  @@index([driverId])
  @@index([driverId, status])
  @@index([extendsBookingId])
  @@index([createdBy])
  @@index([updatedBy])
}
