/// Two shapes, one table (migration 0025). An event booking claims slots from
/// a ParkingCapacity; a host-spot booking claims a stretch of time on one
/// Listing. A DB CHECK enforces that a row is exactly one of the two, and an
/// EXCLUDE constraint is what stops two drivers booking overlapping hours on
/// the same space -- a counter cannot express that, because the thing being
/// competed for is a range rather than a quantity.
///
/// They share a table because everything downstream -- payment, pass,
/// settlement item -- is identical either way.
model Booking {
  id              String        @id @default(uuid())
  parkingCapacityId String?
  /// Set on host-spot bookings only; the event path reaches its listing
  /// through ParkingCapacity.
  listingId       String?
  startsAt        DateTime?
  endsAt          DateTime?
  /// When an unpaid PENDING hold stops reserving the time. Swept on the next
  /// booking attempt for the same spot, so no scheduler is needed.
  holdExpiresAt   DateTime?
  /// Set on an extension: extra time on the same spot, sold as a booking of
  /// its own so the overlap guard holds it while it is paid for. Updating the
  /// parent's `endsAt` instead would hand the time out before payment.
  extendsBookingId String?
  driverId        String
  vehicleNumber   String
  /// Set on host-spot bookings, which choose a rate out of SpotPricing and
  /// would otherwise have nowhere to record which one. An event booking
  /// answers this through its ParkingCapacity.
  vehicleType     String?
  quantity        Int
  amount          Decimal
  status          String        @default("PENDING")
  /// When the driver cancelled, and why if they said. The refund tracker
  /// counts from here; `updatedAt` moves on every later change.
  cancelledAt     DateTime?
  cancellationReason String?
  idempotencyKey  String        @unique
  qrToken         String        @unique
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  parkingCapacity ParkingCapacity? @relation(fields: [parkingCapacityId], references: [id], onDelete: Restrict)
  listing         Listing?        @relation(fields: [listingId], references: [id], onDelete: Restrict)
  driver          User            @relation(fields: [driverId], references: [id])
  payment         Payment?
  refund          Refund?
  settlementItems SettlementItem[]
  extendsBooking  Booking?        @relation("BookingExtensions", fields: [extendsBookingId], references: [id], onDelete: Restrict)
  extensions      Booking[]       @relation("BookingExtensions")
  creator         User?           @relation("BookingCreatedBy", fields: [createdBy], references: [id])
  updater         User?           @relation("BookingUpdatedBy", fields: [updatedBy], references: [id])

  @@index([listingId, startsAt])
  // Created by migration SQL before `db push` was the workflow; declared so a
  // push does not drop them.
  @@index([driverId])
  @@index([driverId, status])
  @@index([extendsBookingId])
  @@index([parkingCapacityId])
  @@index([createdBy])
  @@index([updatedBy])
}
