/// A user who rents out their own parking space. Deliberately a separate table
/// rather than a `role` value: a person can be a driver and a host at the same
/// time, and one `role` column cannot hold both. "Is this user a host" is
/// answered by the existence of this row, never by the JWT.
model HostProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  panNumber          String?
  // Onboarding submits as ACTIVE; the checks behind PENDING are not automated
  // yet. Kept as a column so turning verification on later is a data change,
  // not a schema change.
  verificationStatus String   @default("ACTIVE")

  /// What the host said their bank account is. Held because somebody has to
  /// check it: an admin today, a gateway later. They used to be validated and
  /// discarded, which left payoutKycStatus sitting at UNDER_REVIEW with
  /// nothing to review.
  ///
  /// Read back only in masked form -- see host-payout.service's payoutView.
  /// Once a gateway holds these, this is where they stop being stored.
  payoutAccountName   String?
  payoutAccountNumber String?
  payoutIfsc          String?
  payoutSubmittedAt   DateTime?

  /// The host's account with whoever pays them -- a Cashfree vendor id today.
  /// Named for the job rather than the vendor so a gateway change is an
  /// integration-layer mapping, not a migration.
  payoutAccountId    String?  @unique
  /// Mirrored from the gateway. A host with ACTIVATED here can receive money;
  /// anything else means a payout would bounce, which is why a listing cannot
  /// go live on our own verificationStatus alone.
  payoutKycStatus    String   @default("NOT_STARTED")

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings           Listing[]         @relation("ListingHost")
  settlements        Settlement[]
}

/// When a host's spot can be booked, as weekly recurring windows. This cannot
/// live in ParkingCapacity: that models a fixed count of slots for one fixed
/// date, while a host's spot is the same single space offered again every
/// week.
///
/// Price does NOT live here -- see SpotPricing. Two windows on one spot
/// quoting different rates was a bug waiting for the first driver who booked
/// across the boundary between them.
///
/// Scoped to a Listing, not a HostProfile: a host can list more than one
/// spot, each at its own address with its own hours, so the windows have to
/// live with the spot they describe rather than the host that owns it.
///
/// Overlapping windows on the same spot and weekday are refused by the
/// database, not by application code: see the EXCLUDE constraint in migration
/// 0023. Two concurrent "add window" requests cannot both pass a read-then-
/// write check, which is exactly the race a host creates by double-tapping.
model HostAvailability {
  id            String   @id @default(uuid())
  listingId     String
  // 0 = Sunday .. 6 = Saturday, matching JS getDay().
  dayOfWeek     Int
  // Minutes from midnight, local venue time. Integers rather than DateTime
  // because these are times of day, not instants.
  startMinute   Int
  endMinute     Int
  // Host's kill switch. Off means the window stays configured but the spot
  // stops appearing in search, which is what a host wants when their own car
  // is parked there.
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([dayOfWeek, isActive])
}
