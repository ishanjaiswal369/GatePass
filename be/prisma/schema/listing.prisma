model Listing {
  id            String        @id @default(uuid())
  // An event listing belongs to an organizer; an INDEPENDENT_SPOT belongs to
  // a host. Exactly one of the two is set, which the create path enforces.
  organizerId   String?
  hostProfileId String?
  listingType   String        @default("EVENT")
  name          String
  venueName     String
  latitude      Decimal?
  longitude     Decimal?
  eventDate     DateTime?
  status        String        @default("DRAFT")

  // ---- Host spot fields. Null on event listings. ----

  /// DRIVEWAY / GARAGE / CAR_PARK / PRIVATE_LOT / SOCIETY / COMMERCIAL
  /// (constants/enums/space-type.ts). No ON_STREET: a host cannot warrant
  /// exclusive use of public kerbside.
  spaceType     String?
  /// A line or two in the host's words, public ("Covered parking inside a
  /// gated society").
  description   String?
  /// The spot's own address, in the host's words. A host can list more than
  /// one spot, so this cannot live on HostProfile (one row per host, holding
  /// only the address from whichever spot happened to save it last) the way
  /// it did when a host had only one.
  ///
  /// Composed on save from building, society and street, so older readers
  /// keep one line. Released to a driver only with a paid booking.
  addressLine   String?
  /// Public: the society or complex, and the locality. Enough to judge the
  /// place before booking, not enough to walk up to one house.
  societyName   String?
  area          String?
  /// Private until paid: the house / flat / plot and the street.
  building      String?
  street        String?
  /// When the host placed the pin on the map themselves. A search result's
  /// point is the middle of an area, not a parking space, so it doesn't count.
  pinConfirmedAt DateTime?
  city          String?
  state         String?
  pincode       String?
  /// Kept from the address autocomplete so a re-geocode can be matched back
  /// to the same place instead of drifting to a new pin.
  googlePlaceId String?
  /// What the space offers: CCTV, SECURITY_GUARD, COVERED, EV_CHARGING,
  /// WELL_LIT, WASHROOM (constants/enums/amenity.ts). Only what is always
  /// true -- drivers filter on these. "24/7 access" is not one: it is derived
  /// from the opening hours, so it can never contradict them.
  amenities     String[]      @default([])
  /// The host's own "Other" amenity, public ("Car wash on request").
  amenityNote   String?
  /// Which vehicle types may park (CAR, BIKE). Chosen before prices, so it
  /// can't be read off SpotPricing; empty on older rows, where the priced
  /// types are the answer.
  vehicleTypes  String[]      @default([])
  /// The largest vehicle that fits, and the clearance: shown before booking
  /// so a driver with an SUV doesn't find out at the gate.
  maxVehicleHeightCm Int?
  /// HATCHBACK / SEDAN / SUV / VAN. SUVs and vans are sizes of car, not
  /// separately priced types.
  maxVehicleSize String?
  /// The bay itself, when the host measured it. Public: it decides whether a
  /// car fits and whether its doors open.
  bayWidthCm    Int?
  bayLengthCm   Int?
  /// Booking rules (null = the platform's own limits). Enforced on search,
  /// quote, booking and extension.
  minStayMinutes Int?
  maxStayMinutes Int?
  advanceDays   Int?
  /// Which gate or entrance, public before booking. The detailed
  /// instructions below are not.
  entryPoint    String?
  /// SECURITY_GUARD / GATE_CODE / INTERCOM / MANUAL_GATE / OPEN_ACCESS /
  /// OTHER. Public: "there's a guard" helps a driver decide; the code doesn't.
  entryMethod   String?
  /// Which bay, and how to recognise it. Private until paid, like the
  /// instructions they complete.
  bayNumber     String?
  parkingMarker String?
  /// The host's own house rules, public ("No commercial vehicles").
  rules         String?
  /// Set while the host has paused new bookings. Bookings already made, and
  /// extra time on them, are unaffected; search and new bookings skip it.
  bookingsPausedAt DateTime?
  /// How the driver actually gets in: gate code, guard's name, which bell.
  /// Free text on purpose -- a yes/no "is there a gate" tells a driver
  /// standing outside at 9pm nothing useful.
  accessInstructions String?
  /// Electricity bill or property tax receipt proving the host controls the
  /// space. Checked by a human before the listing is allowed to go live.
  ownershipDocUrl String?
  /// ELECTRICITY_BILL / PROPERTY_TAX / ALLOTMENT_LETTER / OTHER.
  ownershipDocType String?
  /// OWNER or OWNER_PERMISSION: owning a space and being allowed to rent
  /// someone else's are different promises, and review checks them differently.
  permissionBasis String?
  /// Whether the space is in a housing society or RWA-managed property; when
  /// it is, the host's confirmation of that body's permission, as an instant.
  inSociety     Boolean?
  societyPermissionAt DateTime?
  /// When the host ticked the RWA-permission / liability warranty box. A
  /// timestamp rather than a boolean: consent is evidence, and evidence needs
  /// to say when.
  warrantyAcceptedAt DateTime?
  submittedAt   DateTime?
  /// When an admin accepted the ownership document. Separate from status on
  /// purpose: doc approval and payout-account activation are two independent
  /// gates, either can land first, and the listing publishes when both are in.
  /// Folding this into status would lose whichever arrived first.
  docApprovedAt DateTime?
  reviewedAt    DateTime?
  reviewedBy    String?
  /// Shown to the host so a rejection is actionable rather than a dead end.
  rejectionReason String?
  /// Which wizard step the rejection is about (type, address, photos,
  /// details, availability, pricing, access, documents, payout), so the host
  /// is taken straight to it.
  rejectionSection String?

  createdBy     String?
  updatedBy     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  organizer     Organizer?    @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  hostProfile   HostProfile?  @relation("ListingHost", fields: [hostProfileId], references: [id], onDelete: Restrict)
  creator       User?         @relation("ListingCreatedBy", fields: [createdBy], references: [id])
  updater       User?         @relation("ListingUpdatedBy", fields: [updatedBy], references: [id])
  reviewer      User?         @relation("ListingReviewedBy", fields: [reviewedBy], references: [id])
  capacities    ParkingCapacity[]
  photos        SpotPhoto[]
  pricing       SpotPricing[]
  availability  HostAvailability[]
  /// Host-spot bookings, which claim a stretch of this listing's time rather
  /// than a slot from a ParkingCapacity. Empty on event listings.
  spotBookings  Booking[]
  favorites     Favorite[]
  reviews       Review[]
  blocks        ListingBlock[]
  problems      ProblemReport[]

  @@index([organizerId])
  @@index([hostProfileId])
  @@index([listingType, status])
  @@index([status, eventDate])
  @@index([status, submittedAt])
  @@index([latitude, longitude])
  @@index([createdBy])
  @@index([updatedBy])
}

model ParkingCapacity {
  id            String    @id @default(uuid())
  listingId     String
  vehicleType   String
  // Entrance the driver is sent to, printed on the pass. Per vehicle type
  // because bikes and cars rarely share a gate. Null where a venue has one.
  gate          String?
  totalCapacity Int
  bookedCount   Int       @default(0)
  price         Decimal
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  listing       Listing   @relation(fields: [listingId], references: [id])
  bookings      Booking[]

  @@unique([listingId, vehicleType])
}

/// What a host charges, per vehicle type, for one spot.
///
/// Same shape as ParkingCapacity's (listing, vehicleType) -> price, and for
/// the same reason: a bike and a car are not worth the same. Split out of
/// HostAvailability deliberately -- price hanging off each weekly window meant
/// the same spot could quote two different rates depending on which window a
/// driver's booking happened to land in.
model SpotPricing {
  id            String   @id @default(uuid())
  listingId     String
  vehicleType   String
  /// Null when the host doesn't rent by the hour (daily only).
  /// At least one of the two is set, enforced on save.
  pricePerHour  Decimal?
  /// Optional ways to rent the same space. A stay is charged the cheaper of
  /// hourly and daily; null means the host doesn't offer that model.
  pricePerDay   Decimal?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, vehicleType])
}

/// Photos of a host's spot, in the order the host arranged them.
///
/// A table rather than a String[] column: each photo carries its own position
/// and upload time, and deleting one should not mean rewriting an array.
model SpotPhoto {
  id         String   @id @default(uuid())
  listingId  String
  /// Object-store URL. The API hands out a presigned PUT and only ever stores
  /// the resulting URL -- image bytes never pass through this server.
  url        String
  /// 0-based display order. The first photo is the listing's cover.
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, position])
}

/// A spot a driver saved for later. One row per (driver, spot); saving twice
/// is a no-op, not a duplicate.
model Favorite {
  id        String   @id @default(uuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([listingId])
}

/// Hours a host has taken off sale on one space: a family function, repairs.
///
/// Not a Booking, so the Booking_no_overlap EXCLUDE can't see it. Bookings,
/// extensions and blocks therefore all check each other inside a per-listing
/// advisory lock (lib/listing-lock) -- the lock is what makes "is it free?"
/// and "take it" one step for both sides.
model ListingBlock {
  id        String   @id @default(uuid())
  listingId String
  startsAt  DateTime
  endsAt    DateTime
  /// The host's own note; shown only to the host.
  reason    String?
  createdBy String
  createdAt DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  creator   User     @relation("ListingBlockCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([listingId, startsAt])
  @@index([createdBy])
}
