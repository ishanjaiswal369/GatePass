/// A monthly reservation (Phase 6): the same hours on the same weekdays, for
/// 1, 3, 6 or 12 months, paid once up front. No auto-renewal.
///
/// Not a Booking. A Mon-Fri 9-7 term is many time ranges, and a Booking row
/// is exactly one (the Booking_one_target CHECK). Reserving the whole term as
/// one range would take evenings and weekends off sale too. So the term lives
/// here, and every path that claims time on a listing -- hourly booking,
/// extension, host block, another term -- checks it occurrence by occurrence
/// inside the per-listing advisory lock (lib/listing-lock, lib/monthly).
///
/// Dates are the venue's own (IST) calendar dates, "YYYY-MM-DD"; `endDate` is
/// exclusive. Money is fixed at reservation, like a booking's.
model MonthlyReservation {
  id                 String    @id @default(uuid())
  listingId          String
  driverId           String
  vehicleNumber      String
  vehicleType        String
  /// Weekdays, 0 = Sunday .. 6 = Saturday.
  days               Int[]
  startMinute        Int
  endMinute          Int
  startDate          String
  months             Int
  endDate            String
  pricePerMonth      Decimal
  /// pricePerMonth x months: the host's supply.
  amount             Decimal
  /// config/pricing.ts: monthlyPlatformFeeRate of the amount, and GST on it.
  platformFee        Decimal
  taxAmount          Decimal
  status             String    @default("PENDING")
  holdExpiresAt      DateTime?
  idempotencyKey     String    @unique
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  listing            Listing   @relation(fields: [listingId], references: [id], onDelete: Restrict)
  driver             User      @relation("MonthlyReservationDriver", fields: [driverId], references: [id], onDelete: Restrict)
  payment            Payment?
  refund             Refund?
  settlementItems    SettlementItem[]

  @@index([listingId, status])
  @@index([driverId, status])
}
