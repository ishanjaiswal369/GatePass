/// One line in a user's inbox (Phase 4).
///
/// Written only by notification.service's `notify`, which applies the
/// recipient's preferences first. Titles and bodies are composed there from
/// ids and stored facts -- never from text another user typed.
///
/// `dedupeKey` makes a reminder idempotent: "starts soon" for booking X is
/// written once however many times the inbox is opened inside the window.
///
/// The table is also the push outbox: a row with `pushedAt` null and a recent
/// `createdAt` is sent by push-dispatch, which claims it by setting
/// `pushedAt` first. A row written inside a transaction that rolls back never
/// exists, so it is never pushed.
model Notification {
  id         String    @id @default(uuid())
  userId     String
  /// See constants/enums/notification-kind.ts.
  kind       String
  title      String
  body       String
  bookingId  String?
  listingId  String?
  dedupeKey  String?
  readAt     DateTime?
  /// When push-dispatch claimed it (sent, or skipped: push off, no device).
  pushedAt   DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([pushedAt, createdAt])
}

// What a user wants to hear about lives in UserSettings (settings.prisma).
