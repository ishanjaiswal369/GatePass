/// Money in, for one booking. Written with the booking, in the same
/// transaction, before the gateway is called -- so the gateway's order always
/// has a row to land on, and a retry finds it instead of making a second.
///
/// Gateway-neutral: `provider` says whose ids the gateway* columns hold. The
/// row's id is also the gateway call's idempotency key.
model Payment {
  id                  String        @id @default(uuid())
  bookingId           String        @unique
  /// "cashfree". Null on a row from before a gateway was configured.
  provider            String?
  /// Our order id at the gateway (Cashfree `order_id`).
  gatewayOrderId      String?       @unique
  /// The gateway's own id for the order (Cashfree `cf_order_id`).
  gatewayOrderRef     String?
  /// The gateway's id for the successful payment (Cashfree `cf_payment_id`), from the webhook.
  gatewayPaymentId    String?
  /// What the app's checkout SDK opens (Cashfree `payment_session_id`). Only
  /// ever returned to the booking's own driver.
  gatewaySessionId    String?
  /// When the gateway stops accepting payment for the order: the hold's expiry.
  gatewayExpiresAt    DateTime?
  /// When the gateway was last asked how the order's payments stand. Claimed
  /// with one conditional write, so screens polling a booking make at most
  /// one gateway call per few seconds between them.
  gatewayCheckedAt    DateTime?
  /// Everything the driver pays: the booking's amount + platformFee + taxAmount (the last two now zero).
  amount              Decimal
  /// The host's payee at the gateway (Easy Split vendor id) and what the order
  /// routes to them: the parking less GatePass's service fee. Fixed when the
  /// order is first opened, so a retry sends the same split and a later change
  /// of COMMISSION_RATE never rewrites an order already made.
  splitVendorId       String?
  splitAmount         Decimal?
  status              String        @default("CREATED")
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  booking             Booking       @relation(fields: [bookingId], references: [id])
  creator             User?         @relation("PaymentCreatedBy", fields: [createdBy], references: [id])
  updater             User?         @relation("PaymentUpdatedBy", fields: [updatedBy], references: [id])

  @@index([createdBy])
  @@index([updatedBy])
}

/// Money going back to a driver for a cancelled booking.
///
/// Its own table rather than more Booking statuses: a booking is CANCELLED
/// the moment the driver cancels, while the refund is still on its way for
/// days after. Folding both into one status would make "cancelled" and
/// "refunded" mutually exclusive, when a refunded booking is both.
///
/// The amount is decided by the cancellation policy at the moment of
/// cancelling and never recomputed. Moving it to REFUNDED is the payment
/// integration's job.
/// Money going back to a driver (specs/cashfree-refunds_design.md). Opened
/// inside the transaction that decides it, sent to the gateway by
/// refund.service once that has committed.
model Refund {
  id          String    @id @default(uuid())
  bookingId   String    @unique
  amount      Decimal
  status      String    @default("REFUND_PENDING")
  /// The rule that set the amount, shown back to the driver.
  policy      String
  /// The bank's reference for the refund (Cashfree refund_arn), once it has one.
  reference   String?
  processedAt DateTime?
  /// Our refund_id at the gateway for the current attempt, derived from this
  /// row: a repeat of the same attempt is refused by the gateway, never doubled.
  gatewayRefundId  String?  @unique
  /// The gateway's own id for it (Cashfree cf_refund_id).
  gatewayRefundRef String?
  /// The host's part of this refund (Easy Split), fixed on the first send.
  splitAmount Decimal?
  /// 1 for the first; an admin retry after a failure is the next (at most 3).
  attempt     Int       @default(1)
  /// Sends of the current attempt that got no answer from the gateway.
  sendTries   Int       @default(0)
  /// When the gateway accepted the current attempt.
  submittedAt DateTime?
  /// The last send or status check: claims one at a time, and spaces retries.
  checkedAt   DateTime?
  /// Why it FAILED, in the gateway's words or ours.
  failureReason String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([status])
}
