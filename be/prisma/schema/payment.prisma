/// For a booking or a monthly reservation -- exactly one of the two ids is
/// set. Enforced in code: `db push` can't carry a CHECK constraint.
model Payment {
  id                  String        @id @default(uuid())
  bookingId           String?       @unique
  monthlyReservationId String?      @unique
  razorpayOrderId     String?
  razorpayPaymentId   String?
  amount              Decimal
  status              String        @default("CREATED")
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  booking             Booking?      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  monthlyReservation  MonthlyReservation? @relation(fields: [monthlyReservationId], references: [id], onDelete: Restrict)
  creator             User?         @relation("PaymentCreatedBy", fields: [createdBy], references: [id])
  updater             User?         @relation("PaymentUpdatedBy", fields: [updatedBy], references: [id])

  @@index([createdBy])
  @@index([updatedBy])
}

/// Money going back to a driver for a cancelled booking.
///
/// Its own table rather than more Booking statuses: a booking is CANCELLED
/// the moment the driver cancels, while the refund is still on its way for
/// days after. Folding both into one status would make "cancelled" and
/// "refunded" mutually exclusive, when a refunded booking is both.
///
/// The amount is decided by the cancellation policy at the moment of
/// cancelling and never recomputed. Moving it to REFUNDED is the payment
/// integration's job.
model Refund {
  id          String    @id @default(uuid())
  /// Exactly one of these two is set (enforced in code, as on Payment).
  bookingId   String?   @unique
  monthlyReservationId String? @unique
  amount      Decimal
  status      String    @default("REFUND_PENDING")
  /// The rule that set the amount, shown back to the driver.
  policy      String
  /// The gateway's reference once the refund is sent.
  reference   String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  booking     Booking?  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  monthlyReservation MonthlyReservation? @relation(fields: [monthlyReservationId], references: [id], onDelete: Restrict)

  @@index([status])
}
