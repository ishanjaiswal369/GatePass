/// A user's settings: one row, created on first change. No row means every
/// default below, so a new account needs no write.
///
/// Every setting is a column, boolean or string, never a JSON blob: each one
/// is typed, has its default here, and is validated by name
/// (requests/settings.request.ts). The notification switches are what
/// `notify` checks before writing an inbox entry (constants/enums/
/// notification-kind.ts maps each kind to its switch); `push` is what
/// push-dispatch checks before sending one to a phone.
model UserSettings {
  id              String   @id @default(uuid())
  userId          String   @unique

  // What to be told about. Booking receipts and payment problems have no
  // switch: they're always delivered.
  startingSoon    Boolean  @default(true)
  endingSoon      Boolean  @default(true)
  refunds         Boolean  @default(true)
  reviewReminders Boolean  @default(true)
  hostNewBookings Boolean  @default(true)
  hostPayouts     Boolean  @default(true)
  hostListing     Boolean  @default(true)

  // How to be told. Push is delivered (push-dispatch); email is stored only.
  push            Boolean  @default(true)
  email           Boolean  @default(true)
  offers          Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
