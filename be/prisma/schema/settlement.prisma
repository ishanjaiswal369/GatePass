model Settlement {
  id                String              @id @default(uuid())
  // Exactly one payee is set. Hosts are paid by the same periodic engine as
  // organizers in v1 -- instant payout (Razorpay Route) is a known, deliberate
  // omission, not an oversight.
  organizerId       String?
  hostProfileId     String?
  periodStart       DateTime
  periodEnd         DateTime
  grossAmount       Decimal
  commissionAmount  Decimal
  netPayable        Decimal
  status            String              @default("PENDING")
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organizer         Organizer?          @relation(fields: [organizerId], references: [id])
  hostProfile       HostProfile?        @relation(fields: [hostProfileId], references: [id])
  items             SettlementItem[]
  creator           User?               @relation("SettlementCreatedBy", fields: [createdBy], references: [id])
  updater           User?               @relation("SettlementUpdatedBy", fields: [updatedBy], references: [id])
}

model SettlementItem {
  id                String    @id @default(uuid())
  settlementId      String
  bookingId         String
  amount            Decimal
  commissionDeducted Decimal
  createdAt         DateTime  @default(now())

  settlement        Settlement @relation(fields: [settlementId], references: [id])
  booking           Booking    @relation(fields: [bookingId], references: [id])

  @@index([settlementId])
  @@index([bookingId])
}
