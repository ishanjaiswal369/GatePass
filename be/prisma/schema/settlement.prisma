model Settlement {
  id                String              @id @default(uuid())
  // Exactly one payee is set. Hosts are paid by the same periodic engine as
  // organizers in v1 -- instant payout (Razorpay Route) is a known, deliberate
  // omission, not an oversight.
  organizerId       String?
  hostProfileId     String?
  periodStart       DateTime
  periodEnd         DateTime
  grossAmount       Decimal
  commissionAmount  Decimal
  netPayable        Decimal
  status            String              @default("PENDING")
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organizer         Organizer?          @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  hostProfile       HostProfile?        @relation(fields: [hostProfileId], references: [id], onDelete: Restrict)
  items             SettlementItem[]
  creator           User?               @relation("SettlementCreatedBy", fields: [createdBy], references: [id])
  updater           User?               @relation("SettlementUpdatedBy", fields: [updatedBy], references: [id])

  @@index([organizerId])
  @@index([hostProfileId])
  @@index([createdBy])
  @@index([updatedBy])
}

/// One payee line of a settlement: a booking, or (Phase 6) a monthly
/// reservation -- exactly one id set, enforced in code. A monthly term can be
/// settled month by month, so it may appear in several settlements.
model SettlementItem {
  id                String    @id @default(uuid())
  settlementId      String
  bookingId         String?
  monthlyReservationId String?
  amount            Decimal
  commissionDeducted Decimal
  createdAt         DateTime  @default(now())

  settlement        Settlement @relation(fields: [settlementId], references: [id])
  booking           Booking?   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  monthlyReservation MonthlyReservation? @relation(fields: [monthlyReservationId], references: [id], onDelete: Restrict)

  @@index([settlementId])
  @@index([bookingId])
  @@index([monthlyReservationId])
}
