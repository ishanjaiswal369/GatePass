model User {
  id              String   @id @default(uuid())
  email           String   @unique
  phone           String?  @unique
  // Google's `sub`: stable for the life of the Google account, unlike the
  // email. Matching on it first means a user who changes their Google address
  // still lands on the same row.
  googleId        String?  @unique
  firstName       String?
  lastName        String?
  role            String   @default("DRIVER")
  // scrypt hash, null until the user sets one. Email-code and Google sign-in
  // stay available either way -- a password is an addition, not a migration.
  passwordHash    String?
  passwordSetAt   DateTime?
  gstNumber       String?
  bankAccountId   String?
  // Set when the user deletes their account. Deletion is soft: the row and
  // all its data are kept as they were, sign-in is refused, and clearing this
  // restores the account. Bookings, payments and settlements point here too.
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hostProfile     HostProfile?
  vehicles        Vehicle[]
  address         UserAddress?
  organizerMemberships OrganizerMember[]
  bookings        Booking[]
  sessions        UserSession[]
  createdListings Listing[]   @relation("ListingCreatedBy")
  updatedListings Listing[]   @relation("ListingUpdatedBy")
  reviewedListings Listing[]  @relation("ListingReviewedBy")
  createdBookings Booking[]   @relation("BookingCreatedBy")
  updatedBookings Booking[]   @relation("BookingUpdatedBy")
  createdPayments Payment[]   @relation("PaymentCreatedBy")
  updatedPayments Payment[]   @relation("PaymentUpdatedBy")
  createdSettlements Settlement[] @relation("SettlementCreatedBy")
  updatedSettlements Settlement[] @relation("SettlementUpdatedBy")
}
