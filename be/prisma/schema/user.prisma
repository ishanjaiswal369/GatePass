model User {
  id              String   @id @default(uuid())
  email           String   @unique
  phone           String?  @unique
  // Google's `sub`: stable for the life of the Google account, unlike the
  // email. Matching on it first means a user who changes their Google address
  // still lands on the same row.
  googleId        String?  @unique
  firstName       String?
  lastName        String?
  role            String   @default("DRIVER")
  gstNumber       String?
  bankAccountId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  listings        Listing[]
  bookings        Booking[]
  settlements     Settlement[]
  sessions        UserSession[]
  createdListings Listing[]   @relation("ListingCreatedBy")
  updatedListings Listing[]   @relation("ListingUpdatedBy")
  createdBookings Booking[]   @relation("BookingCreatedBy")
  updatedBookings Booking[]   @relation("BookingUpdatedBy")
  createdPayments Payment[]   @relation("PaymentCreatedBy")
  updatedPayments Payment[]   @relation("PaymentUpdatedBy")
  createdSettlements Settlement[] @relation("SettlementCreatedBy")
  updatedSettlements Settlement[] @relation("SettlementUpdatedBy")
}
