# Google OAuth client IDs from Google Cloud Console.
# The sign-in button only renders when the web id is set, so leaving these
# blank hides it rather than showing a button that cannot work.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=""

# Defaults to http://localhost:3000 -- which on a phone is the phone itself.
# On a real device use an address the phone can reach:
#   - testing on your Wi-Fi: http://<your computer's LAN IP>:3000 (a debug or
#     development build; Android *release* builds refuse plain http)
#   - store / release builds: the API's https:// URL
EXPO_PUBLIC_API_URL=""

# Where "Contact Support" and "Help & Support" send drivers. Unset, they use
# the address on the Contact page (src/features/legal/content.json).
EXPO_PUBLIC_SUPPORT_EMAIL=""
