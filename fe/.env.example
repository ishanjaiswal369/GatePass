# Google OAuth client IDs from Google Cloud Console.
# The sign-in button only renders when the web id is set, so leaving these
# blank hides it rather than showing a button that cannot work.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=""

# Defaults to http://localhost:3000
EXPO_PUBLIC_API_URL=""

# Where "Contact Support" and "Help & Support" send drivers. Unset, those
# buttons explain that support isn't reachable from this build.
EXPO_PUBLIC_SUPPORT_EMAIL=""
# Base URL of the published terms/privacy pages (docs/ on GitHub Pages).
EXPO_PUBLIC_LEGAL_BASE_URL=""
